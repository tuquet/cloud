{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TuquetCloudTestPreset",
  "description": "Declarative test preset definition for tuquet-cloud identities and tenants",
  "type": "object",
  "required": ["name", "user"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Unique identifier for this preset"
    },
    "description": {
      "type": "string",
      "description": "Human readable description of the scenario"
    },
    "user": {
      "type": "object",
      "required": ["email", "password"],
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "password": {
          "type": "string",
          "minLength": 6
        },
        "full_name": {
          "type": "string"
        },
        "avatar_url": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "tenant": {
      "type": "object",
      "required": ["slug", "name"],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "avatar_url": {
          "type": "string"
        },
        "plan": {
          "type": "string",
          "enum": ["free", "pro", "enterprise"]
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "role": {
      "type": "string",
      "enum": ["owner", "admin", "member", "viewer"],
      "default": "owner"
    }
  }
}
