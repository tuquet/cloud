{
  "id": "automation",
  "name": "Automation Cloud Bridge",
  "version": "1.0.0",
  "schema": "automation",
  "description": "Distributed browser automation engine coordinator, composite package blocks, campaign executions, and telemetry logs",
  "dependencies": [
    "workers"
  ],
  "tables": [
    "automation.workflows",
    "automation.packages",
    "automation.jobs",
    "automation.execution_logs",
    "automation.schedules"
  ],
  "permissions": [
    "automation:workflows:read",
    "automation:workflows:manage",
    "automation:packages:read",
    "automation:packages:manage",
    "automation:jobs:read",
    "automation:jobs:run",
    "automation:jobs:manage",
    "automation:logs:read"
  ]
}
